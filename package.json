{
  "private": true,
  "name": "dumi-book",
  "scripts": {
    "start": "dumi dev",
    "build": "dumi build",
    "prettier": "prettier --write \"**/*.{js,jsx,tsx,ts,less,md,json}\""
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "devDependencies": {
    "dumi": "^2.4.50",
    "lint-staged": "^10.0.7",
    "prettier": "^2.2.1",
    "typescript": "^7.0.2",
    "yorkie": "^2.0.0"
  },
  "dependencies": {
    "@lobehub/fluent-emoji": "^4.0.0",
    "@lobehub/icons": "^4.0.0",
    "@lobehub/ui": "^4.3.3",
    "antd": "^6.1.1",
    "dumi-theme-lobehub": "^5.0.0",
    "motion": "^12.23.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
